version: "3.9"

services:
  dhcp-server:
    image: dhcp-server
    container_name: dhcp-server
    network_mode: host
    cap_add:
      - NET_ADMIN
    environment:
      - DHCP_INTERFACE=ens37
    volumes:
      - /home/it22093264/vcct-assignment/dhcp-server/dhcpd.conf:/etc/dhcp/dhcpd.conf:ro
      - /home/it22093264/vcct-assignment/dhcp-server/dhcpd-data:/var/lib/dhcpd
    restart: unless-stopped

  dns-server:
    image: dns-server
    container_name: dns-server-11
    depends_on:
      - dhcp-server
    ports:
      - "192.168.8.20:53:53/udp"
      - "192.168.8.20:53:53/tcp"
    
    restart: unless-stopped

  squid-proxy:
    image: my-squid-proxy
    container_name: squid-proxy-4
    depends_on:
      - dhcp-server
    ports:
      - "3128:3128"
    deploy:
      resources:
        limits:
          cpus: "1"
          memory: 512M
    volumes:
      - /home/it22093264/vcct-assignment/squid-proxy/logs:/var/log/squid
    restart: unless-stopped
