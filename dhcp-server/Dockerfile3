# Use the lightweight Alpine Linux as the base image
FROM alpine:latest

# Update the package index and install the modern Kea DHCPv4 server
RUN apk update && \
    apk add --no-cache kea-dhcp4

# Kea runs as its own user by default, which is good for security.
# We just need to make sure its directories exist.
RUN mkdir -p /var/lib/kea && \
    chown kea:kea /var/lib/kea

# Copy the new Kea configuration file
COPY kea-dhcp4.conf /etc/kea/kea-dhcp4.conf

# Copy the entrypoint script
COPY entrypoint2.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose the standard DHCP ports
EXPOSE 67/udp 68/udp

# Set the entrypoint to our script
ENTRYPOINT ["/entrypoint.sh"]
